# ====================================================================
# SWARNANET — Supabase & Application Environment Configuration
# Copy this file to .env.local and fill in your Supabase project keys.
# ====================================================================

# Supabase Project URL (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (client-side safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (STRICTLY SERVER-SIDE - NEVER EXPOSE AS NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Optional: Application Port
PORT=3000
